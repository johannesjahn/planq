# Base URL the browser uses to reach the planq API.
# Left at the default, requests go to `/api/*` on the same origin, which the Vite
# dev server proxies to the backend (see `server.proxy` in vite.config.ts).
# Point this at the API's real origin (e.g. https://api.example.com) for a build
# that talks to a backend on a different host.
VITE_API_BASE_URL=/api

# Where the dev-server proxy forwards `/api/*` during `bun run dev`.
VITE_PROXY_TARGET=http://localhost:3000
