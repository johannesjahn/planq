  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "additionalProperties": false
      },
      "HttpApiDecodeError": {
        "type": "object",
        "required": [
          "issues",
          "message",
          "_tag"
        ],
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Issue"
            }
          },
          "message": {
            "type": "string"
          },
          "_tag": {
            "type": "string",
            "enum": [
              "HttpApiDecodeError"
            ]
          }
        },
        "additionalProperties": false,
        "description": "The request did not match the expected schema"
      },
      "Issue": {
        "type": "object",
        "required": [
          "_tag",
          "path",
          "message"
        ],
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "Pointer",
              "Unexpected",
              "Missing",
              "Composite",
              "Refinement",
              "Transformation",
              "Type",
              "Forbidden"
            ],
            "description": "The tag identifying the type of parse issue"
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertyKey"
            },
            "description": "The path to the property where the issue occurred"
          },
          "message": {
            "type": "string",
            "description": "A descriptive message explaining the issue"
          }
        },
        "additionalProperties": false,
        "description": "Represents an error encountered while parsing a value to match the schema"
      },
      "PropertyKey": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "object",
            "required": [
              "_tag",
              "key"
            ],
            "properties": {
              "_tag": {
                "type": "string",
                "enum": [
                  "symbol"
                ]
              },
              "key": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "an object to be decoded into a globally shared symbol"
          }
        ]
      },
      "ServiceUnavailable": {
        "type": "object",
        "required": [
          "check",
          "_tag"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "_tag": {
            "type": "string",
            "enum": [
              "ServiceUnavailable"
            ]
          }
        },
        "additionalProperties": false
      },
      "RegisterPayload": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "description": "Unique username",
            "title": "maxLength(32)",
            "pattern": "^[a-zA-Z0-9_]+$",
            "minLength": 3,
            "maxLength": 32,
            "allOf": [
              {
                "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$"
              }
            ]
          },
          "password": {
            "type": "string",
            "description": "User password, minimum 8 characters",
            "title": "maxLength(128)",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "additionalProperties": false
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "username",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "a Universally Unique Identifier",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "username": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UsernameAlreadyInUse": {
        "type": "object",
        "required": [
          "username",
          "_tag"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "_tag": {
            "type": "string",
            "enum": [
              "UsernameAlreadyInUse"
            ]
          }
        },
        "additionalProperties": false
      },
      "PayloadTooLarge": {
        "type": "object",
        "required": [
          "maxBytes",
          "_tag"
        ],
        "properties": {
          "maxBytes": {
            "type": "number"
          },
          "_tag": {
            "type": "string",
            "enum": [
              "PayloadTooLarge"
            ]
          }
        },
        "additionalProperties": false
      },
      "TooManyRequests": {
        "type": "object",
        "required": [
          "retryAfterSeconds",
          "_tag"
        ],
        "properties": {
          "retryAfterSeconds": {
            "type": "number"
          },
          "_tag": {
            "type": "string",
            "enum": [
              "TooManyRequests"
            ]
          }
        },
        "additionalProperties": false
      },
      "LoginPayload": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "description": "Unique username",
            "title": "maxLength(32)",
            "pattern": "^[a-zA-Z0-9_]+$",
            "minLength": 3,
            "maxLength": 32,
            "allOf": [
              {
                "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$"
              }
            ]
          },
          "password": {
            "type": "string",
            "description": "User password, minimum 8 characters",
            "title": "maxLength(128)",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "additionalProperties": false
      },
      "InvalidCredentials": {
        "type": "object",
        "required": [
          "_tag"
        ],
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "InvalidCredentials"
            ]
          }
        },
        "additionalProperties": false
      },
      "Unauthorized": {
        "type": "object",
        "required": [
          "_tag"
        ],
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "Unauthorized"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "health"
    },
    {
      "name": "auth"
    },
    {
      "name": "users"
    }
  ]
}
