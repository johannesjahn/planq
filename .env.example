PORT=3000
DB_FILENAME=planq.sqlite

# Required, and deliberately left blank: an unedited copy of this file must fail
# to start rather than run on a key that is public in this repository. The
# server rejects a secret shorter than 32 characters, one that matches a known
# placeholder, or one built from a handful of repeated characters.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Largest request body the API will read, in bytes. Anything bigger is answered
# with 413 before it is buffered or parsed. The biggest payload the API defines
# is well under 1 KB, so this is already generous.
MAX_REQUEST_BODY_BYTES=8192

# Auth rate limiting. All optional — the values below are the defaults.
# Set RATE_LIMIT_ENABLED=false only for local experiments, never in a deployment.
RATE_LIMIT_ENABLED=true
# Per-IP request budget for POST /auth/login.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# Per-IP request budget for POST /auth/register.
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
# Per-username lockout: after RATE_LIMIT_LOCKOUT_THRESHOLD consecutive failed
# logins the account is locked for RATE_LIMIT_LOCKOUT_BASE_SECONDS, doubling on
# every further failure up to RATE_LIMIT_LOCKOUT_MAX_SECONDS. A successful login
# clears the streak, as does RATE_LIMIT_FAILURE_WINDOW_SECONDS of quiet.
RATE_LIMIT_LOCKOUT_THRESHOLD=5
RATE_LIMIT_LOCKOUT_BASE_SECONDS=30
RATE_LIMIT_LOCKOUT_MAX_SECONDS=900
RATE_LIMIT_FAILURE_WINDOW_SECONDS=3600

# Set to true only when a reverse proxy you control overwrites X-Forwarded-For
# and X-Forwarded-Proto. Otherwise clients can forge those headers to hand
# themselves a fresh rate-limit bucket, or to suppress the HSTS header below.
TRUST_PROXY=false

# max-age for Strict-Transport-Security, in seconds (default one year). The
# header is only sent on requests that arrived over HTTPS — directly, or via
# X-Forwarded-Proto when TRUST_PROXY=true — so a plain-HTTP local setup never
# sees it. Set to 0 to disable it outright, which is the only option for a host
# that has to keep answering over HTTP: a max-age already sent to a browser
# cannot be withdrawn before it expires.
HSTS_MAX_AGE_SECONDS=31536000
